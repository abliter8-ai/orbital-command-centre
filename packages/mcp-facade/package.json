{
  "name": "@occ/mcp-facade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "occ-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/stdio.js",
    "refresh-models": "node dist/refresh-models-cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@occ/adapter-antigravity": "workspace:*",
    "@occ/adapter-claude": "workspace:*",
    "@occ/adapter-codex": "workspace:*",
    "@occ/adapter-cursor": "workspace:*",
    "@occ/adapter-grok": "workspace:*",
    "@occ/adapter-kit": "workspace:*",
    "@occ/core": "workspace:*",
    "@prefecthq/fastmcp-ts": "^1.5.1",
    "zod": "^4.4.3"
  }
}
