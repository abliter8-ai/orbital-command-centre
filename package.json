{
  "name": "orbital-command-centre",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run && node scripts/test-register-flip.mjs",
    "test:watch": "vitest",
    "typecheck": "pnpm -r exec tsc -p tsconfig.json --noEmit",
