{
  "name": "@occ/acp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "occ-acp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/stdio.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@occ/adapter-antigravity": "workspace:*",
    "@occ/adapter-codex": "workspace:*",
    "@occ/adapter-cursor": "workspace:*",
    "@occ/adapter-grok": "workspace:*",
    "@occ/core": "workspace:*"
  }
}
